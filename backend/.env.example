# Choose: openai or deepseek
DEPLOYMENT_MODE=local
AI_PROVIDER=deepseek

# OpenAI (optional when AI_PROVIDER=deepseek)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
AI_FALLBACK_TO_DEEPSEEK=true
ENABLE_TAILORED_RESUME=true
ENABLE_COVER_LETTER=true
ENABLE_SELECTION_CRITERIA=true
ENABLE_ATS_ANALYSIS=true

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local application settings
AI_REQUEST_TIMEOUT_SECONDS=90
TARGET_ENGLISH_VARIANT=Australian English
DEFAULT_SC_WORD_TARGET=350
DATABASE_URL=sqlite:///./data/job_assistant.db
FRONTEND_ORIGIN=http://localhost:3000
