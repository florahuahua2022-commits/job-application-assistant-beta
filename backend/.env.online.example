DEPLOYMENT_MODE=online

AI_PROVIDER=deepseek
AI_FALLBACK_TO_DEEPSEEK=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Use the pooled Postgres connection supplied by the online database provider.
DATABASE_URL=

# Authentication values are created by the online Auth project.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Backend only. Never expose this value through a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=

# Conservative closed-beta defaults.
DAILY_PACK_LIMIT_PER_USER=3
MONTHLY_PACK_LIMIT_GLOBAL=50
ALLOW_PUBLIC_SIGNUP=false
ENABLE_TAILORED_RESUME=true
ENABLE_COVER_LETTER=true
ENABLE_SELECTION_CRITERIA=true
ENABLE_ATS_ANALYSIS=true

# Set this to the deployed frontend origin before launch.
FRONTEND_ORIGIN=
TARGET_ENGLISH_VARIANT=Australian English
