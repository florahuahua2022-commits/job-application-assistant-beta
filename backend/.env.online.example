DEPLOYMENT_MODE=online

AI_PROVIDER=deepseek
AI_FALLBACK_TO_DEEPSEEK=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0

# Optional OpenAI fallback pricing. Keep at zero until current provider rates are entered.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0

# Use the pooled Postgres connection supplied by the online database provider.
DATABASE_URL=

# Authentication values are created by the online Auth project.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Comma-separated Supabase user UUIDs allowed to use the private Override API.
ADMIN_USER_IDS=

# Conservative closed-beta defaults.
DAILY_PACK_LIMIT_PER_USER=3
MONTHLY_PACK_LIMIT_GLOBAL=50
ALLOW_PUBLIC_SIGNUP=false
ENABLE_TAILORED_RESUME=true
ENABLE_COVER_LETTER=true
ENABLE_SELECTION_CRITERIA=true
ENABLE_ATS_ANALYSIS=true

# Set this to the deployed frontend origin before launch.
FRONTEND_ORIGIN=
TARGET_ENGLISH_VARIANT=Australian English
